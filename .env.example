# ============================================================
#  AI 健康助手 · 环境变量模板
#  复制为 .env 后填写真实值。.env 严禁提交到 Git（已在 .gitignore）
# ============================================================

# ---------- 运行环境 ----------
NODE_ENV=production
TZ=Asia/Shanghai
# 对外访问域名（含协议），用于 CORS / OAuth 回调 / 前端 SSR 请求后端
APP_URL=https://your-domain.com
API_PORT=3001
WEB_PORT=3000

# ---------- Supabase（主库 + 向量库 + Auth）----------
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# 仅服务端使用，绝不下发到浏览器
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# 直连 Postgres（迁移 / 批量写入），Supabase → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ---------- JWT（自建签发，与 Supabase Auth 并存）----------
JWT_SECRET=please-change-me-to-a-64-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# 密码哈希轮数
BCRYPT_ROUNDS=12

# ---------- Redis（京东云 / 容器内）----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0
# 会话限流：单用户每分钟消息数
RATE_LIMIT_PER_MIN=30

# ---------- 大模型（任意 OpenAI 兼容接口均可）----------
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Embedding：bge-m3 = 1024 维；text-embedding-3-small = 1536 维
# 切换模型时必须同步修改 supabase/migrations 里 knowledge_chunks.embedding 的维度
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxxxxxx
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---------- RAG 检索参数 ----------
RAG_TOP_K=6
RAG_SCORE_THRESHOLD=0.35
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
# 混合检索：向量权重 vs 关键词权重（0~1）
RAG_HYBRID_VECTOR_WEIGHT=0.7

# ---------- 微信登录（可选，资质齐了再填即可启用）----------
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://your-domain.com/api/auth/wechat/callback

# ---------- 短信验证码（手机号登录，可选）----------
SMS_ENABLED=false
SMS_PROVIDER=tencent
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=

# ---------- 安全与合规 ----------
# 回答强制附带的免责声明开关（强烈建议保持 true）
MEDICAL_DISCLAIMER_ENABLED=true
# 命中这些关键词时拒绝给诊断结论、引导就医
RED_FLAG_TERMS=胸痛,呼吸困难,意识丧失,大出血,持续高热,抽搐,自杀

# ---------- Nginx / TLS ----------
# certbot 申请证书用
SSL_DOMAIN=your-domain.com
SSL_EMAIL=you@example.com
